{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @monorepo/server build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @monorepo/server start",
    "healthcheckPath": "/health"
  }
}
