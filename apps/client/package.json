{
  "name": "@monorepo/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor:react": "react-doctor --no-score --blocking none",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist",
    "tokens:source": "node scripts/build-token-source.mjs",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "tokens:update": "pnpm tokens:source && pnpm tokens:generate"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@monorepo/api-contracts": "workspace:*",
    "@monorepo/recommendation-engine": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "ky": "^2.0.2",
    "modern-css-reset": "^1.4.0",
    "rc-slider": "^11.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-kakao-maps-sdk": "^1.2.1",
    "react-router-dom": "^7.15.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "react-doctor": "^0.9.11",
    "react-grab": "^0.1.50",
    "react-scan": "^0.5.7",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
