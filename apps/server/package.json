{
  "name": "@monorepo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --sourcemap --external:express --external:cors --external:bcryptjs --external:cookie-parser --external:drizzle-orm --external:jsonwebtoken --external:postgres --external:resend --external:zod --external:ai --external:@ai-sdk/openai --external:ky --external:playwright",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:recommendation-campaign": "tsc -p tsconfig.recommendation-campaign.json --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx src/scripts/recommendation-engine/test.ts",
    "test:recommendation-campaign": "node --import tsx --test src/scripts/recommendation-engine/test/cli.test.ts src/scripts/recommendation-engine/test/campaign.test.ts src/scripts/recommendation-engine/test/review.test.ts",
    "recommendation:campaign": "node --env-file-if-exists=.env --import tsx src/scripts/recommendation-engine/campaign-runner.ts",
    "recommendation:review": "node --import tsx src/scripts/recommendation-engine/review.ts",
    "test:course": "node --import tsx --test src/courseRecommendation/*.test.ts src/routes/courseCandidates.test.ts src/routes/savedPlaces.test.ts",
    "test:history": "node --import tsx --test src/recommendation/history.test.ts",
    "clean": "rm -rf dist",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.64",
    "@monorepo/api-contracts": "workspace:*",
    "@monorepo/course-recommendation-engine": "workspace:*",
    "@monorepo/recommendation-engine": "workspace:*",
    "ai": "^6.0.183",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "ky": "^2.0.2",
    "playwright": "^1.60.0",
    "postgres": "^3.4.9",
    "resend": "^6.17.2",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.17",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.3"
  }
}
